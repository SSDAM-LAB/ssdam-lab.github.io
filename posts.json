layout: null
---
[{% for p in site.posts %}
{"slug":{{ p.slug | jsonify }},"title":{{ p.title | jsonify }},"date":{{ p.date | date: "%Y-%m-%d" | jsonify }},"at":{{ p.date | date_to_xmlschema | jsonify }},"tags":{{ p.tags | jsonify }},"url":{{ p.url | relative_url | jsonify }},"html":{{ p.content | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}
]
